# ─── REAS Backend — Environment Variables ─────────────────────────────────────
# Copy this file to .env and fill in the values.
# On Railway: set these in the Railway dashboard → Variables tab.

# Port (Railway sets this automatically — do NOT override on Railway)
PORT=5005

# Your Vercel frontend URL (no trailing slash)
# e.g. https://reas.vercel.app
CLIENT_URL=https://YOUR_VERCEL_APP.vercel.app

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/reas?retryWrites=true&w=majority

# Gmail SMTP — for email OTP delivery
# Use a Google App Password (not your Gmail password)
# https://myaccount.google.com/apppasswords
GMAIL_USER=your.email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Fast2SMS — for SMS OTP delivery (Indian numbers)
# Get your key from https://fast2sms.com/dashboard/dev-api
FAST2SMS_API_KEY=your_fast2sms_api_key

# Google OAuth Client ID
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
