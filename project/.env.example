# ─── REAS Frontend — Environment Variables ────────────────────────────────────
# On Vercel: add these in Project Settings → Environment Variables.
# Locally: copy to .env and fill in values.

# Your deployed backend URL (Railway/Render/Fly.io) — no trailing slash
VITE_API_URL=https://YOUR_BACKEND.up.railway.app/api
VITE_SOCKET_URL=https://YOUR_BACKEND.up.railway.app

# Mapbox public token — get yours at https://account.mapbox.com
VITE_MAPBOX_TOKEN=pk.your_mapbox_public_token_here

# Google OAuth Client ID
# Must match the one in Google Cloud Console → Credentials
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
